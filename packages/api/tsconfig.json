{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "es2016",
    "moduleResolution": "node",
    "module": "commonjs",
    "sourceMap": true,
    "noUnusedLocals": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "lib": [
      "esnext"
    ]
  },
  "exclude": [
  ],
}
